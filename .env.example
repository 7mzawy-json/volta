# Copy to .env and set your deployed origin.
#
# Link previews are built by scrapers that do not run JavaScript — WhatsApp,
# Facebook, Slack, iMessage, LinkedIn, Twitter. They read the HTML as served, so
# the URL has to be baked in at build time; it cannot be discovered at runtime
# the way the browser does it. Open Graph also requires an ABSOLUTE url, which is
# why a relative "/" is not merely untidy but invalid.
#
# Bare origin only — scheme and host, no trailing slash, no path.
VITE_SITE_ORIGIN=https://your-project.vercel.app
