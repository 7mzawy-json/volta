# Copy to server/.env for local work. NEVER commit the real file — .gitignore
# already excludes it, and every value below is a credential.
#
# In production these are set in Render's dashboard (Environment tab), not in a
# file. Render's blueprint marks them `sync: false` precisely so they cannot be
# committed by accident.

# --- database ---------------------------------------------------------------
# Local, via Docker:   docker run -d -p 27017:27017 --name volta-mongo mongo:7
#   MONGODB_URI=mongodb://127.0.0.1:27017/volta
# Production: a MongoDB Atlas connection string (free M0 tier is enough).
MONGODB_URI=mongodb://127.0.0.1:27017/volta

# --- sessions ---------------------------------------------------------------
# Signs the session cookie. Any long random string; changing it logs everyone
# out. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_TTL=7d

# --- where the browser app lives --------------------------------------------
# Used for CORS and for the URLs Stripe returns the shopper to.
SITE_ORIGIN=http://localhost:5173
# Optional extra allowed origins, comma separated (e.g. a Vercel preview URL).
EXTRA_ORIGINS=

# --- Stripe (test mode) ------------------------------------------------------
# From dashboard.stripe.com in TEST mode. The secret key starts sk_test_ — if
# yours starts sk_live_ you are about to take real money, stop.
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint you create in the Stripe dashboard, starts whsec_.
# Without it the webhook route rejects everything rather than trusting unsigned
# input, which is the correct failure.
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=4000
NODE_ENV=development
